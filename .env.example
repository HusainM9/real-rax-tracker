# Optional overrides for Meowbot API (defaults are baked into the app).
# Use publishable keys only — never put private secrets in VITE_* variables.
VITE_MEOWBOT_SUPABASE_URL=
VITE_MEOWBOT_SUPABASE_KEY=

# Vercel site gate (set in Vercel dashboard only — not in the React bundle).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
AUTH_SESSION_SECRET=
