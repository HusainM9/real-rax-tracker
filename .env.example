# Optional overrides for Meowbot API (defaults are baked into the app).
# Use publishable keys only — never put private secrets in VITE_* variables.
VITE_MEOWBOT_SUPABASE_URL=
VITE_MEOWBOT_SUPABASE_KEY=

# Local dev only: Entry page uses admin cached import instead of live Meowbot.
# Requires KV_REST_* in .env.local and an admin import for that username first.
# VITE_TEST_ADMIN_CACHE_IMPORT=true

# Real pass import (server-side only — these are live bot-account credentials).
# Never commit real values and never expose them via VITE_*.
REAL_IMPORT_ENABLED=false
REAL_AUTH_INFO=
REAL_SESSION_TOKEN=
REAL_DEVICE_UUID=
# Optional overrides (defaults are safe).
REAL_BASE_URL=https://web.realapp.com
REAL_DEVICE_TYPE=desktop_web
REAL_DEVICE_NAME=
REAL_VERSION=35
REAL_IMPORT_TIMEOUT_MS=12000
# Upstream Real calls in parallel per earnings batch (default 2). Lower if you still see 429s.
REAL_IMPORT_CONCURRENCY=2
# Extra attempts after a 429 (default 5 ⇒ up to 6 total tries).
REAL_IMPORT_MAX_RETRIES=5
REAL_IMPORT_RETRY_BASE_MS=750
REAL_IMPORT_RETRY_MAX_MS=20000
# Shared catalog TTL for daily RAX backfill cache hits (hours). 0 disables freshness (always refetch).
REAL_EARNINGS_CACHE_TTL_HOURS=12
# Admin shop earningstotal crawl (shop page + per-item daily earnings). Delay between Real calls;
# pages per chunk (default 1); concurrency (default 2). Keep delay low on Vercel — 1500ms × 21
# calls exceeds Hobby limits and returns FUNCTION_INVOCATION_FAILED with 0 writes.
REAL_SHOP_CRAWL_DELAY_MS=300
REAL_SHOP_CRAWL_MAX_PAGES=1
REAL_SHOP_CRAWL_EARNINGS_CONCURRENCY=2
# Soft wall-clock budget per chunk (ms). Crawl returns JSON early instead of being hard-killed.
REAL_SHOP_CRAWL_BUDGET_MS=22000

# Client-side switch that re-enables username import in the UI.
# Must be set together with REAL_IMPORT_ENABLED above.
VITE_REAL_IMPORT_ENABLED=false

# Vercel site gate (set in Vercel dashboard only — not in the React bundle).
BASIC_AUTH_PASSWORD=
AUTH_SESSION_SECRET=
# Authenticates Vercel's 6:30 AM Eastern earnings snapshot cron.
CRON_SECRET=

# Admin operator area (/admin) — separate from the site password.
ADMIN_PASSWORD=

# Vercel KV / Redis (linked in Vercel dashboard for admin event logging and cloud profile sync).
# For localhost account login (same cloud views as production), copy these from Vercel into .env.local
# together with AUTH_SESSION_SECRET (and TRACKER_SYNC_SECRET if set in prod), then restart npm run dev.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional extra pepper for account password hashing (falls back to AUTH_SESSION_SECRET).
# Only needed if you set it in Vercel — most installs never use this.
TRACKER_SYNC_SECRET=

# Shared Supabase catalog (server-only; never expose service-role keys via VITE_*).
# Required on Vercel for shop crawl upserts. Use the project URL only (no /rest/v1).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

